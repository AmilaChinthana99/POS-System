datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isMain    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  sales            Sale[]
  stockAdjustments StockAdjustment[]
  purchaseOrders   PurchaseOrder[]
  expenses         Expense[]
  returns          Return[]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CASHIER") // ADMIN, MANAGER, CASHIER
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs     ActivityLog[]
  sales            Sale[]
  voidedSales      Sale[]            @relation("VoidedBy")
  adjustments      StockAdjustment[]
  expenses         Expense[]
  processedReturns Return[]          @relation("ProcessedBy")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                String   @id @default(uuid())
  name              String
  sku               String   @unique
  barcode           String   @unique
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  costPrice         Float    @default(0.0)
  sellingPrice      Float    @default(0.0)
  taxRate           Float    @default(0.0)
  stockQuantity     Float    @default(0.0)
  minStockThreshold Float    @default(5.0)
  unit              String   @default("pcs") // pcs, kg, g, box, pack, bottle
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]
  poItems          PurchaseOrderItem[]
  returnItems      ReturnItem[]
}

model StockAdjustment {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch   @relation(fields: [branchId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quantityChange Float
  type           String // ADD, REMOVE
  reason         String // DAMAGE, RETURN, CORRECTION, EXPIRED, RESTOCK
  notes          String?
  createdAt      DateTime @default(now())
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales   Sale[]
  returns Return[]
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  poNumber      String    @unique
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  status        String    @default("PENDING") // PENDING, RECEIVED, CANCELLED
  totalAmount   Float     @default(0.0)
  paymentStatus String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  notes         String?
  createdAt     DateTime  @default(now())
  receivedAt    DateTime?

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Float
  quantityReceived Float         @default(0.0)
  unitCost         Float
  totalCost        Float
}

model Sale {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique
  branchId       String
  branch         Branch    @relation(fields: [branchId], references: [id])
  cashierId      String
  cashier        User      @relation(fields: [cashierId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  subtotal       Float     @default(0.0)
  discountAmount Float     @default(0.0)
  taxAmount      Float     @default(0.0)
  grandTotal     Float     @default(0.0)
  paidAmount     Float     @default(0.0)
  changeAmount   Float     @default(0.0)
  paymentStatus  String    @default("COMPLETED") // COMPLETED, REFUNDED, PARTIALLY_REFUNDED, VOIDED
  paymentMethod  String    @default("CASH") // CASH, CARD, BANK_TRANSFER, MOBILE, SPLIT
  isHeld         Boolean   @default(false)
  holdReference  String?
  voidReason     String?
  voidedByUserId String?
  voidedByUser   User?     @relation("VoidedBy", fields: [voidedByUserId], references: [id])
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items    SaleItem[]
  payments SalePayment[]
  returns  Return[]
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  productName    String
  unitPrice      Float
  costPrice      Float
  taxRate        Float   @default(0.0)
  quantity       Float
  discountAmount Float   @default(0.0)
  subtotal       Float
  total          Float

  returnItems ReturnItem[]
}

model SalePayment {
  id              String   @id @default(uuid())
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   String // CASH, CARD, BANK_TRANSFER, MOBILE
  amount          Float
  referenceNumber String?
  createdAt       DateTime @default(now())
}

model Return {
  id                String    @id @default(uuid())
  returnNumber      String    @unique
  saleId            String
  sale              Sale      @relation(fields: [saleId], references: [id])
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  processedById     String
  processedBy       User      @relation("ProcessedBy", fields: [processedById], references: [id])
  branchId          String
  branch            Branch    @relation(fields: [branchId], references: [id])
  totalRefundAmount Float
  refundMethod      String    @default("CASH") // CASH, CARD, STORE_CREDIT
  reason            String
  createdAt         DateTime  @default(now())

  items ReturnItem[]
}

model ReturnItem {
  id            String   @id @default(uuid())
  returnId      String
  returnRecord  Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId    String
  saleItem      SaleItem @relation(fields: [saleItemId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Float
  refundAmount  Float
  returnToStock Boolean  @default(true)
}

model ExpenseCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id           String          @id @default(uuid())
  title        String
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount       Float
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  expenseDate  DateTime        @default(now())
  notes        String?
  receiptImage String?
  createdAt    DateTime        @default(now())
}

model ShopSettings {
  id                String   @id @default(uuid())
  shopName          String   @default("EcoLife Plastic-Free Market")
  tagline           String?  @default("Sustainable & Eco-Friendly Goods")
  logoUrl           String?
  address           String   @default("123 Green Street, Colombo 03, Sri Lanka")
  phone             String   @default("+94 11 234 5678")
  email             String   @default("contact@ecolifemarket.lk")
  taxNumber         String?  @default("VAT-987654321")
  currencySymbol    String   @default("Rs.")
  currencyCode      String   @default("LKR")
  receiptFooterText String   @default("Thank you for shopping green! Every step counts.")
  defaultTaxRate    Float    @default(8.0)
  enableLoyalty     Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}
